# 服务配置
PORT=8000
HOST=127.0.0.1

# 推理模式：local（本地）或 remote（远程转发）
ENGINE_MODE=local

# 远程引擎地址（ENGINE_MODE=remote 时使用）
REMOTE_ENGINE_URL=http://localhost:11434

# 模型路径（设置为本地模型目录，留空则不加载）
# 注意：已禁用自动下载。请先手动下载模型后再配置路径。
# ModelScope 下载地址：https://modelscope.cn/models/mlx-community / https://modelscope.cn/models/Qwen
# 可将模型放在 ~/.lmstudio/models/ 下，或在下方设置路径
TTS_MODEL_PATH=
ASR_MODEL_PATH=
ALIGNER_MODEL_PATH=

# 模型来源：modelscope（魔搭）或 huggingface
MODEL_SOURCE=modelscope

# 模型缓存目录（可选）
MODEL_CACHE_DIR=
